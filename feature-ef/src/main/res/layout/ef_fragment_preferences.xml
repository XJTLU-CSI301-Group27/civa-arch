<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/CivaText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ef_preferences_title" />

        <TextView
            style="@style/CivaText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ef_preferences_subtitle" />

        <TextView
            style="@style/CivaText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ef_preferences_liked_tags" />

        <EditText
            android:id="@+id/ef_preferences_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/ef_preferences_field"
            android:hint="@string/ef_preferences_tags_hint"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:textColor="@color/civa_text"
            android:textColorHint="@color/civa_muted"
            android:textSize="15sp" />

        <TextView
            style="@style/CivaText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ef_preferences_excluded" />

        <TextView
            android:id="@+id/ef_preferences_excluded_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/civa_muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ef_preferences_excluded_pick"
            style="@style/CivaWidget.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ef_preferences_pick_excluded" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ef_preferences_save"
            style="@style/CivaWidget.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ef_preferences_save" />

        <TextView
            android:id="@+id/ef_preferences_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/civa_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
