<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingTop="10dp" android:paddingBottom="28dp">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/ef_profile_language" android:layout_width="50dp" android:layout_height="50dp" android:contentDescription="@string/ef_language" android:padding="14dp" android:background="@drawable/ef_language_button" android:elevation="2dp" app:srcCompat="@drawable/ef_ic_language_globe" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="232dp" android:clipChildren="false" android:clipToPadding="false">
            <FrameLayout android:layout_width="match_parent" android:layout_height="132dp" android:layout_gravity="bottom" android:background="@drawable/ef_profile_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="132dp" android:paddingEnd="20dp" android:paddingTop="20dp">
                    <TextView android:id="@+id/ef_profile_account" style="@style/CivaText.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="23sp" android:maxLines="2" android:ellipsize="end" />
                    <TextView android:id="@+id/ef_profile_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textSize="11sp" android:textColor="@color/civa_muted" android:maxLines="2" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/ef_profile_edit" style="@style/CivaWidget.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end|bottom" android:layout_marginEnd="9dp" android:layout_marginBottom="5dp" android:insetTop="0dp" android:insetBottom="0dp" android:padding="12dp" android:minWidth="0dp" android:contentDescription="@string/ef_edit_profile" app:icon="@drawable/ef_ic_edit" app:iconPadding="0dp" app:iconGravity="textStart" app:iconSize="22dp" />
            </FrameLayout>
            <ImageView android:id="@+id/ef_profile_avatar" android:layout_width="100dp" android:layout_height="100dp" android:layout_marginStart="18dp" android:layout_marginTop="65dp" android:contentDescription="@string/ef_profile_avatar" />
            <ImageView android:id="@+id/ef_profile_cat" android:layout_width="220dp" android:layout_height="108dp" android:layout_gravity="top|end" android:layout_marginEnd="12dp" android:src="@drawable/civa_cat_family" android:scaleType="fitEnd" android:importantForAccessibility="no" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:background="@drawable/ef_profile_card" android:orientation="vertical" android:padding="22dp">
            <TextView style="@style/CivaText.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:text="@string/ef_profile_household" />
            <TextView android:id="@+id/ef_profile_household_name" style="@style/CivaText.WelcomeSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" />
            <TextView android:id="@+id/ef_profile_household" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/civa_text" android:textSize="13sp" />
            <TextView android:id="@+id/ef_profile_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:textColor="@color/civa_muted" android:textSize="13sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/ef_profile_household_action" style="@style/CivaWidget.SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ef_profile_household_settings" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/ef_profile_logout" style="@style/CivaWidget.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/ef_profile_logout" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/ef_profile_footer" android:textSize="12sp" android:textColor="@color/civa_muted" android:gravity="center" />
    </LinearLayout>
</ScrollView>
