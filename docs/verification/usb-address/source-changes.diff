--- a/app/build.gradle
+++ b/app/build.gradle
@@ -13,6 +13,16 @@
     throw new GradleException('CIVA_API_BASE_URL must be an HTTP(S) origin ending in /, without credentials, query or fragment.')
 }
 
+
+// Machine-local debug target survives Android Studio Run; never supplies the release origin.
+def localDebugSettings = new Properties()
+def localSettingsFile = rootProject.file('local.properties')
+if (localSettingsFile.isFile()) localSettingsFile.withInputStream { localDebugSettings.load(it) }
+def debugApiUrl = configuredApiUrl ?: localDebugSettings.getProperty('civa.debugApiBaseUrl') ?: 'http://10.0.2.2:8080/'
+if (!validateApiUrl(debugApiUrl, false)) {
+    throw new GradleException('civa.debugApiBaseUrl must be an HTTP(S) origin ending in /, without credentials, query or fragment.')
+}
+
