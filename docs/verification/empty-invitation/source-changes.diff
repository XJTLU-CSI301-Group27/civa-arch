+            @Override public void onSuccess(Void ignored) {
+                if (closed || !owner.equals(sessions.currentUserId()) || !home.equals(sessions.currentHouseholdId())) return;
+                calls.enqueue(api.household().createInvitation(UUID.fromString(home), UUID.fromString(key)), new ApiCallback<edu.xjtlu.civa.api.model.Invitation>() {
+                    @Override public void onSuccess(edu.xjtlu.civa.api.model.Invitation result) {
+                        if (closed) return;
