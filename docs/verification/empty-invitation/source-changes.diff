+    }
+
+    void join() {
+        String trimmed = code == null ? "" : code.trim();
+        if (trimmed.isEmpty()) { message.postValue("VALIDATION_ERROR"); return; }
+        if (trimmed.matches("(?i)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")) { message.postValue("INVITATION_IS_HOUSEHOLD_ID"); return; }
