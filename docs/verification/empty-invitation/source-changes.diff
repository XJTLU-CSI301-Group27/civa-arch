+                        calls.pendingWrites().confirm(owner, key, new ApiCallback<Void>() {
+                            @Override public void onSuccess(Void value) { complete(); }
+                            @Override public void onError(ApiError error) { complete(); }
+                            private void complete() {
+                                if (closed || !owner.equals(sessions.currentUserId()) || !home.equals(sessions.currentHouseholdId())) return;
