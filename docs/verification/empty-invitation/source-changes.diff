+package edu.xjtlu.civa.server.household;
+
+import edu.xjtlu.civa.server.application.IdempotencyExecutor;
+import edu.xjtlu.civa.server.config.JsonbCodec;
+import java.security.SecureRandom;
+import java.sql.Timestamp;
+import java.time.Clock;
+import java.time.temporal.ChronoUnit;
+import java.time.ZoneOffset;
+import java.time.format.DateTimeFormatter;
+import java.util.UUID;
+import org.springframework.jdbc.core.JdbcTemplate;
+
+/** Owner-only, 128-bit, single-use invitations, expiring after 24 hours. */
+final class HouseholdInvitationService {
+    private static final DateTimeFormatter TIME=DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'").withZone(ZoneOffset.UTC);
+    private final JdbcTemplate jdbc;
+    private final IdempotencyExecutor idempotency;
+    private final JsonbCodec json;
+    private final InvitationReceiptCipher receipts;
+    private final Clock clock;
+    private final SecureRandom random=new SecureRandom();
+
+    HouseholdInvitationService(JdbcTemplate jdbc, IdempotencyExecutor idempotency, JsonbCodec json, InvitationReceiptCipher receipts, Clock clock) {
+        this.jdbc=jdbc;this.idempotency=idempotency;this.json=json;this.receipts=receipts;this.clock=clock;
+    }
+
+    IdempotencyExecutor.Result create(UUID actor, UUID home, UUID key, byte[] digest) {
+        IdempotencyExecutor.Result protectedResult=idempotency.execute(actor,key,digest,()->{
+            requireOwner(actor,home);
+            String code=InvitationCodes.generate(random);UUID id=UUID.randomUUID();var expiry=clock.instant().plus(24,ChronoUnit.HOURS);
+            jdbc.update("INSERT INTO invitations(id,household_id,created_by,code_hash,expires_at) VALUES (?,?,?,?,?)",id,home,actor,InvitationCodes.hash(code),Timestamp.from(expiry));
+            var body=json.object();body.put("id",id.toString());body.put("householdId",home.toString());body.put("expiresAt",TIME.format(expiry));body.put("code",receipts.seal(code));
+            return new IdempotencyExecutor.Result(201,json.write(body));
+        }, result->requireOwner(actor,home));
+        var body=json.read(protectedResult.body).deepCopy();
+        ((com.fasterxml.jackson.databind.node.ObjectNode)body).put("code",receipts.open(body.path("code").asText()));
+        return new IdempotencyExecutor.Result(protectedResult.status,json.write(body));
+    }
+
+    private void requireOwner(UUID actor, UUID home) {
+        var homes=jdbc.query("SELECT id FROM households WHERE id=? FOR UPDATE",(rs,n)->rs.getObject(1,UUID.class),home);
+        if(homes.isEmpty())throw new HouseholdWriteService.Failure("NOT_FOUND");
+        var roles=jdbc.query("SELECT role FROM memberships WHERE household_id=? AND user_id=? AND active FOR UPDATE",(rs,n)->rs.getString(1),home,actor);
+        if(roles.isEmpty()) {
+            Boolean revoked=jdbc.queryForObject("SELECT EXISTS(SELECT 1 FROM memberships WHERE household_id=? AND user_id=? AND NOT active)",Boolean.class,home,actor);
+            throw new HouseholdWriteService.Failure(Boolean.TRUE.equals(revoked)?"HOUSEHOLD_ACCESS_REVOKED":"NOT_FOUND");
+        }
+        if(!"OWNER".equals(roles.get(0)))throw new HouseholdWriteService.Failure("FORBIDDEN");
+    }
+}
