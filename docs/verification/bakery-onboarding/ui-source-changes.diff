+
+/** One 6.6 second launch scene. Returning from logout only creates LoginFragment. */
+final class AppIntroView extends FrameLayout {
+    static final long DURATION = 6600;
+    private final ChefCatView cat;
+    private final TextView bubble;
+    private final long started;
+    private final Runnable done;
+    private MeowSound audio;
+    private boolean voiced, finished;
+    private final Runnable frame = this::tick;
+
+    AppIntroView(Context context, long started, boolean alreadyVoiced, Runnable done) {
+        super(context); this.started=started; this.done=done; this.voiced=alreadyVoiced;
+        setId(R.id.app_intro_scene); setClickable(true); setFocusable(true);
+        setBackgroundColor(ContextCompat.getColor(context, edu.xjtlu.civa.core.ui.R.color.civa_primary_dark));
+        setContentDescription(context.getString(R.string.app_intro_description));
+        cat=new ChefCatView(context); cat.setId(R.id.app_intro_cat); addView(cat);
+        bubble=new TextView(context); bubble.setId(R.id.app_intro_meow);
+        bubble.setText(edu.xjtlu.civa.core.ui.R.string.civa_cat_meow); bubble.setTextSize(24); bubble.setGravity(Gravity.CENTER);
+        bubble.setTypeface(ResourcesCompat.getFont(context,edu.xjtlu.civa.core.ui.R.font.civa_kuaile));
+        bubble.setTextColor(ContextCompat.getColor(context,edu.xjtlu.civa.core.ui.R.color.civa_primary_dark));
+        GradientDrawable shape=new GradientDrawable();shape.setColor(ContextCompat.getColor(context,edu.xjtlu.civa.core.ui.R.color.civa_surface));shape.setCornerRadius(dp(25));bubble.setBackground(shape);
+        bubble.setAccessibilityLiveRegion(ACCESSIBILITY_LIVE_REGION_POLITE); bubble.setVisibility(INVISIBLE); addView(bubble);
+    }
+    boolean hasVoiced() { return voiced; }
+    @Override protected void onAttachedToWindow() { super.onAttachedToWindow();audio=new MeowSound(getContext());postOnAnimation(frame); }
+    private void tick() {
+        if (finished || !isAttachedToWindow() || getWindowVisibility()!=VISIBLE) return;
+        float time=SystemClock.elapsedRealtime()-started;
+        if(time>=DURATION){ finished=true;done.run();return; }
+        float run=Math.min(1,time/2000f);float ease=1-(1-run)*(1-run);
+        float destination=(getWidth()-cat.getWidth())*.5f;
+        cat.setTranslationX((-cat.getWidth()-dp(18))*(1-ease)+destination*ease);
+        float settle=Math.max(0,Math.min(1,(time-2000)/850f));
+        cat.pose(time/100f,settle,0,false);
+        cat.setScaleY(time<2000?1f:1f-.09f*(float)Math.sin(settle*Math.PI));
+        cat.setRotation(time<2000?(float)Math.sin(time/105)*3.5f:0);
+        if(time>=4350 && !voiced){
+            voiced=true;audio.play(()->{if(!isAttachedToWindow()||getWindowVisibility()!=VISIBLE)return; bubble.setVisibility(VISIBLE);bubble.setScaleX(.6f);bubble.setScaleY(.6f);bubble.setAlpha(0f);
+                bubble.animate().alpha(1f).scaleX(1f).scaleY(1f).setDuration(220).setInterpolator(new android.view.animation.OvershootInterpolator(1.2f)).start();});
+        }
+        if(time>5650)bubble.setAlpha(Math.max(0,1-(time-5650)/400f));
+        setAlpha(time<6250?1f:Math.max(0,(DURATION-time)/350f));
+        postOnAnimation(frame);
+    }
+    @Override protected void onMeasure(int ws,int hs){
+        int w=MeasureSpec.getSize(ws),h=MeasureSpec.getSize(hs);setMeasuredDimension(w,h);
+        int ch=Math.min(dp(265),Math.round(h*.42f)),cw=Math.round(ch*.8f);
+        cat.measure(MeasureSpec.makeMeasureSpec(cw,MeasureSpec.EXACTLY),MeasureSpec.makeMeasureSpec(ch,MeasureSpec.EXACTLY));
+        bubble.measure(MeasureSpec.makeMeasureSpec(dp(68),MeasureSpec.EXACTLY),MeasureSpec.makeMeasureSpec(dp(52),MeasureSpec.EXACTLY));
+    }
+    @Override protected void onLayout(boolean changed,int l,int t,int r,int b){
+        int y=(getHeight()-cat.getMeasuredHeight())/2;
+        cat.layout(0,y,cat.getMeasuredWidth(),y+cat.getMeasuredHeight());
+        int x=getWidth()/2+cat.getMeasuredWidth()/2-dp(7);
+        bubble.layout(x,y+dp(12),x+dp(68),y+dp(64));
+    }
+    @Override protected void onWindowVisibilityChanged(int visibility){super.onWindowVisibilityChanged(visibility);
+        if(visibility==VISIBLE&&isAttachedToWindow())postOnAnimation(frame);else{removeCallbacks(frame);if(audio!=null)audio.stop();}}
+    @Override protected void onDetachedFromWindow(){removeCallbacks(frame);bubble.animate().cancel();if(audio!=null){audio.close();audio=null;}super.onDetachedFromWindow();}
+    private int dp(float n){return Math.round(n*getResources().getDisplayMetrics().density);}
+}
