+        for (String legacyScope : new java.util.LinkedHashSet<>(ownedLegacyScopes)) {
+            if (!legacyScope.matches("[0-9a-f]{64}") || legacyScope.equals(scope) || current.migratedScopes.contains(legacyScope)) continue;
