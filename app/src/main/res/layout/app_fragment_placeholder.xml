<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="28dp" android:paddingEnd="28dp"
    android:paddingTop="40dp" android:paddingBottom="24dp">
    <TextView android:id="@+id/app_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" style="@style/CivaText.Title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/app_not_connected"
        style="@style/CivaText.Subtitle" />
</LinearLayout>
