<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/ac_catalog_card"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/ac_row_recipe_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/ac_catalog_search"
            android:hint="@string/ac_household_recipe_row_name"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/civa_text"
            android:textColorHint="@color/civa_muted"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ac_row_remove"
            style="@style/CivaWidget.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/ac_household_recipe_remove_row"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/ac_row_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/ac_catalog_search"
        android:hint="@string/ac_household_recipe_row_amount"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/civa_text"
        android:textColorHint="@color/civa_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/ac_row_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/ac_catalog_search"
        android:hint="@string/ac_household_recipe_row_note"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textColor="@color/civa_text"
        android:textColorHint="@color/civa_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ac_row_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/civa_primary_dark"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ac_row_convert"
        style="@style/CivaWidget.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:text="@string/ac_household_recipe_convert_to_tracked"
        android:textSize="12sp" />
</LinearLayout>
