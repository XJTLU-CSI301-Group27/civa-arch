<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="62dp"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/ac_detail_image"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/ac_catalog_card"
            android:contentDescription="@string/ac_detail_image_label"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ac_detail_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/ac_detail_name"
                style="@style/CivaText.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ac_detail_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/civa_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ac_detail_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/civa_primary_dark"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ac_detail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/civa_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/ac_detail_ingredients_header"
            style="@style/CivaText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ac_catalog_section_ingredients" />

        <LinearLayout
            android:id="@+id/ac_detail_ingredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/ac_detail_recipe_only_header"
            style="@style/CivaText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ac_catalog_section_recipe_only"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ac_detail_recipe_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            style="@style/CivaText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ac_catalog_section_steps" />

        <LinearLayout
            android:id="@+id/ac_detail_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            style="@style/CivaText.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ac_catalog_section_nutrition" />

        <LinearLayout
            android:id="@+id/ac_detail_nutrition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ac_detail_favorite"
            style="@style/CivaWidget.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/ac_catalog_favorite" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ac_detail_save"
            style="@style/CivaWidget.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ac_catalog_save_to_mine" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ac_detail_cook"
            style="@style/CivaWidget.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ac_detail_cook"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ac_detail_add_home"
            style="@style/CivaWidget.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ac_catalog_add_to_home" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ac_detail_edit"
            style="@style/CivaWidget.SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ac_editor_edit_title"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ac_detail_archive"
            style="@style/CivaWidget.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ac_catalog_archive"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ac_detail_delete"
            style="@style/CivaWidget.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ac_catalog_delete"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ac_detail_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/ac_catalog_readonly"
            android:textColor="@color/civa_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

<com.google.android.material.button.MaterialButton android:id="@+id/ac_detail_close" style="@style/CivaWidget.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_marginTop="6dp" android:text="@string/ac_detail_close_symbol" android:textSize="20sp" android:contentDescription="@string/ac_detail_close" android:padding="0dp" android:minWidth="0dp"/>
</FrameLayout>