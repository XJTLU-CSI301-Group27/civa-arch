<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/ac_catalog_title"
        style="@style/CivaText.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_catalog_title" />

    <TextView
        android:id="@+id/ac_catalog_subtitle"
        style="@style/CivaText.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ac_catalog_subtitle" />

    <EditText
        android:id="@+id/ac_catalog_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/ac_catalog_search"
        android:hint="@string/ac_catalog_search"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/civa_text"
        android:textSize="14sp"
        android:textColorHint="@color/civa_muted" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/ac_catalog_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true" />
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ac_catalog_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/ac_catalog_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textSize="13sp"
        android:textColor="@color/civa_muted" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ac_catalog_more"
        style="@style/CivaWidget.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/ac_catalog_more_plain"
        android:visibility="gone" />
</LinearLayout>
