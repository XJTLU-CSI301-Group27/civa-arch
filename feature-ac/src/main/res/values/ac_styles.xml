<resources>
    <!-- Inventory controls inherit the shared CivaWidget button tokens (caramel + kuaile type). -->
    <style name="ac_FridgeAction" parent="CivaWidget.PrimaryButton">
        <item name="backgroundTint">@color/ac_fridge_ink</item>
        <item name="android:textColor">@color/ac_fridge_background</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="ac_FridgeOutline" parent="CivaWidget.SecondaryButton">
        <item name="backgroundTint">@color/ac_fridge_panel</item>
        <item name="android:textColor">@color/ac_fridge_ink</item>
        <item name="strokeColor">@color/ac_fridge_line</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>
</resources>
