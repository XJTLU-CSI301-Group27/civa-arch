<resources>
    <!-- One shared visual system: bakery paper, toasted caramel, apron blue.
         See docs/decisions/ADR-003-shared-visual-system.md. -->
    <style name="CivaTheme.Base" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/civa_primary</item>
        <item name="colorPrimaryVariant">@color/civa_primary_dark</item>
        <item name="colorSecondary">@color/civa_secondary</item>
        <item name="colorSurface">@color/civa_surface</item>
        <item name="colorOnPrimary">@color/civa_surface</item>
        <item name="colorOnSurface">@color/civa_text</item>
        <item name="android:colorAccent">@color/civa_primary</item>
        <item name="android:windowBackground">@color/civa_background</item>
        <item name="android:statusBarColor">@color/civa_background</item>
        <item name="android:navigationBarColor">@color/civa_primary_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="CivaTheme.Civa" parent="CivaTheme.Base" />

    <!-- Typography tokens -->
    <style name="CivaText.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/civa_kuaile</item>
        <item name="android:textColor">@color/civa_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">@font/civa_kuaile</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CivaText.Subtitle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/civa_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CivaText.Section" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/civa_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CivaText.Navigation" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/civa_kuaile</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <!-- Navigation container tokens -->
    <style name="CivaShape.Navigation" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CivaWidget.NavigationIndicator" parent="">
        <item name="android:width">64dp</item>
        <item name="android:height">24dp</item>
        <item name="android:color">@color/civa_primary</item>
        <item name="shapeAppearance">@style/CivaShape.Navigation</item>
    </style>

    <!-- Button tokens -->
    <style name="CivaWidget.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/civa_kuaile</item>
        <item name="android:textColor">@color/civa_surface</item>
        <item name="backgroundTint">@color/civa_primary</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>

    <style name="CivaWidget.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/civa_kuaile</item>
        <item name="android:textColor">@color/civa_primary_dark</item>
    </style>

    <style name="CivaWidget.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/civa_kuaile</item>
        <item name="android:textColor">@color/civa_primary_dark</item>
        <item name="backgroundTint">@color/civa_surface</item>
        <item name="strokeColor">@color/civa_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="CivaText.WelcomeSection" parent="CivaText.Section">
        <item name="fontFamily">@font/civa_kuaile</item>
        <item name="android:fontFamily">@font/civa_kuaile</item>
    </style>
    <style name="CivaWidget.WelcomeInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/civa_surface</item>
        <item name="boxStrokeColor">@color/civa_outline</item>
        <item name="boxCornerRadiusTopStart">20dp</item><item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item><item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="hintTextColor">@color/civa_primary_dark</item>
        <item name="android:textColorHint">@color/civa_muted</item>
    </style>
</resources>
